        <mxCell id="pp4ylgECwNa042N8Hse9-110" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#A5B4FC;fontSize=14;fontStyle=1;align=left;spacingLeft=14;spacingTop=8;verticalAlign=top;fontColor=#1E293B;" value="&lt;b&gt;CHÚ THÍCH UML&lt;/b&gt;&lt;br&gt;① Hình người: actor bên ngoài hệ thống &amp;nbsp;&amp;nbsp; ② Hình elip: use case &amp;nbsp;&amp;nbsp; ③ Khung: phạm vi hệ thống&lt;br&gt;④ Nét liền: actor tương tác với use case &amp;nbsp;&amp;nbsp; ⑤ «include»: bắt buộc gọi use case khác (UC3 → UC4; UC5 → UC6)&lt;br&gt;⑥ «extend»: hành vi mở rộng tùy chọn (UC2 → UC1); mũi tên hướng về use case cơ sở." vertex="1">
