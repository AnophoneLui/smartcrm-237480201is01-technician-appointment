        <mxCell id="pp4ylgECwNa042N8Hse9-111" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#A5B4FC;fontSize=14;fontStyle=1;align=left;spacingLeft=14;spacingTop=8;verticalAlign=top;fontColor=#1E293B;" value="&lt;b&gt;ĐỐI CHIẾU TRUY VẾT VỚI SRS ĐÃ HIỆU CHỈNH&lt;/b&gt;&lt;br&gt;FR1 → US1, US2, US7 → UC1, UC2 &amp;nbsp; | &amp;nbsp; FR2 → US4 → UC4 &amp;nbsp; | &amp;nbsp; FR3 → US3 → UC3&lt;br&gt;FR4 → US5, US6 → UC5, UC6 &amp;nbsp; | &amp;nbsp; FR5 → US8 → UC7 &amp;nbsp; | &amp;nbsp; FR6 → US9, US10 → UC8&lt;br&gt;FR7 → US11 → UC9 &amp;nbsp; | &amp;nbsp; FR8 → US12 → UC10" vertex="1">
          <mxGeometry height="125" width="890" x="600" y="2817.83" as="geometry" />
        </mxCell>
        <mxCell id="pp4ylgECwNa042N8Hse9-112" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#64748B;" value="Lưu ý: UC6 là xử lý được UC5 gọi; không thêm actor “Hệ thống”. UC8 bao gồm cảnh báo trùng lịch theo US10. UC9/UC10 cần đối chiếu phạm vi triển khai BT2." vertex="1">
          <mxGeometry height="34" width="1180" x="455.00328247070314" y="2942.833282470703" as="geometry" />
